# Banco PostgreSQL local embutido. Use um caminho exclusivo por ambiente.
GMOS_DB_NAME=development

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GMOS_PUBLIC_URL=http://localhost:3000

# local grava mensagens em .data/mailbox. Configure outro modo/provedor somente após autorização.
GMOS_MAIL_MODE=local
# GMOS_MAIL_PROVIDER=

# local ou connected. O check conectado exige HTTPS, banco exclusivo e provedor de e-mail.
GMOS_RELEASE_MODE=local

# Copiloto estratégico. Permanece desativado até configuração explícita.
GMOS_AI_PROVIDER=disabled
# Para integração OpenAI, defina ambos somente no ambiente do servidor:
# GMOS_AI_PROVIDER=openai
# GMOS_AI_MODEL=
# OPENAI_API_KEY=
# `local_preview` valida o fluxo local, mas não utiliza modelo de IA.

# Bootstrap controlado; defina apenas no processo que executa o comando.
# GMOS_ADMIN_EMAIL=
# GMOS_ADMIN_NAME=
