{
  "name": "gmos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "bootstrap:admin": "tsx --env-file=.env.local scripts/bootstrap-admin.ts",
    "catalogs:reconcile": "node scripts/reconcile-catalogs.mjs",
    "backup": "tsx --env-file=.env.local scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "release:check": "tsx --env-file=.env.local scripts/check-release.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
